:root {
  --theme-bg: #FFFFFF;
  --theme-surface: #F6F8FA;
  --theme-surface-elevated: #FFFFFF;
  --theme-border: #D0D7DE;
  --theme-text-primary: #1F2328;
  --theme-text-secondary: #656D76;
  --theme-text-dim: #8B949E;
  --theme-shadow: rgba(0, 0, 0, 0.08);
  --theme-primary: #0969DA;
  --theme-primary-hover: #0550AE;
  --theme-primary-active: #033D8B;
  --theme-success: #1A7F37;
  --theme-danger: #CF222E;
  --theme-warning: #9A6700;
  --font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  --font-mono: 'JetBrains Mono', 'Cascadia Code', 'Fira Code', monospace;
  --space-xs: 4px;
  --space-sm: 8px;
  --space-md: 12px;
  --space-lg: 16px;
  --space-xl: 24px;
  --space-2xl: 32px;
  --space-3xl: 48px;
  --radius-sm: 4px;
  --radius-md: 6px;
  --radius-lg: 8px;
  --radius-xl: 12px;
  --radius-full: 9999px;
  --shadow-sm: 0 1px 3px var(--theme-shadow);
  --shadow-md: 0 4px 12px var(--theme-shadow);
  --shadow-lg: 0 8px 24px var(--theme-shadow);
}

[data-theme="dark"] {
  --theme-bg: #0D1117;
  --theme-surface: #161B22;
  --theme-surface-elevated: #1C2333;
  --theme-border: #30363D;
  --theme-text-primary: #F0F6FC;
  --theme-text-secondary: #8B949E;
  --theme-text-dim: #484F58;
  --theme-shadow: rgba(0, 0, 0, 0.4);
  --theme-primary: #58A6FF;
  --theme-primary-hover: #79C0FF;
  --theme-primary-active: #1F6FEB;
  --theme-success: #3FB950;
  --theme-danger: #DA3633;
  --theme-warning: #D29922;
}

* { box-sizing: border-box; margin: 0; padding: 0; }
body { font-family: var(--font-family); background: var(--theme-bg); color: var(--theme-text-primary); height: 100vh; width: 100vw; overflow: hidden; display: flex; flex-direction: column; transition: background-color 200ms ease, color 200ms ease; }
* { transition: background-color 200ms ease, color 200ms ease, border-color 200ms ease, box-shadow 200ms ease; }
@media (prefers-reduced-motion: reduce) { * { transition: none !important; animation-duration: 0.01ms !important; } }

.topbar { height: 40px; min-height: 40px; display: flex; align-items: center; padding: 0 var(--space-lg); gap: var(--space-md); background: var(--theme-surface); border-bottom: 1px solid var(--theme-border); flex-shrink: 0; z-index: 10; }
.topbar__brand { font-weight: 600; font-size: 14px; display: flex; align-items: center; gap: var(--space-sm); color: var(--theme-text-primary); white-space: nowrap; }
.topbar__spacer { flex: 1; }
.topbar__group { display: flex; align-items: center; gap: var(--space-sm); }
.search-bar { display: flex; align-items: center; background: var(--theme-surface-elevated); border: 1px solid var(--theme-border); border-radius: var(--radius-md); padding: 0 var(--space-sm); height: 28px; min-width: 180px; transition: border-color 200ms ease, box-shadow 200ms ease; }
.search-bar:focus-within { border-color: var(--theme-primary); box-shadow: 0 0 0 3px rgba(88, 166, 255, 0.3); }
[data-theme="light"] .search-bar:focus-within { box-shadow: 0 0 0 3px rgba(9, 105, 218, 0.3); }
.search-bar__icon { color: var(--theme-text-dim); font-size: 13px; margin-right: var(--space-sm); flex-shrink: 0; }
.search-bar__input { border: none; background: transparent; color: var(--theme-text-primary); font-size: 12px; width: 100%; outline: none; }
.search-bar__input::placeholder { color: var(--theme-text-dim); }
.search-bar__kbd { color: var(--theme-text-dim); font-size: 10px; background: var(--theme-surface); padding: 0 var(--space-xs); border-radius: var(--radius-sm); border: 1px solid var(--theme-border); flex-shrink: 0; margin-left: var(--space-sm); }
.topbar__button { display: flex; align-items: center; justify-content: center; background: var(--theme-surface-elevated); border: 1px solid var(--theme-border); border-radius: var(--radius-md); color: var(--theme-text-secondary); width: 28px; height: 28px; cursor: pointer; transition: all 150ms ease; font-size: 14px; }
.topbar__button:hover { background: var(--theme-surface); border-color: var(--theme-primary); color: var(--theme-text-primary); }
.theme-toggle { display: flex; align-items: center; justify-content: center; width: 28px; height: 28px; border: 1px solid var(--theme-border); border-radius: var(--radius-md); background: var(--theme-surface-elevated); color: var(--theme-text-primary); cursor: pointer; transition: all 150ms ease; font-size: 14px; }
.theme-toggle:hover { background: var(--theme-surface); border-color: var(--theme-primary); }

.main-area { display: flex; flex: 1; min-height: 0; overflow: hidden; }
.sidebar { width: 240px; min-width: 240px; background: var(--theme-surface); border-right: 1px solid var(--theme-border); display: flex; flex-direction: column; overflow: hidden; flex-shrink: 0; }
.sidebar-section { border-bottom: 1px solid var(--theme-border); padding: var(--space-md) var(--space-lg); flex-shrink: 0; }
.sidebar-section:last-child { border-bottom: none; flex: 1; overflow-y: auto; }
.sidebar-section__title { color: var(--theme-text-secondary); font-size: 11px; text-transform: uppercase; letter-spacing: 0.05em; font-weight: 600; margin-bottom: var(--space-sm); }

/* File Tree */
.file-tree {
  font-size: 12px;
  font-family: var(--font-mono);
  color: var(--theme-text-primary);
}
.file-tree__item {
  display: flex;
  align-items: center;
  gap: var(--space-sm);
  padding: 2px 0;
  cursor: pointer;
  border-radius: var(--radius-sm);
  padding-left: var(--space-sm);
  transition: background 150ms ease;
}
.file-tree__item:hover {
  background: var(--theme-border);
}
.file-tree__item--folder {
  font-weight: 500;
}
.file-tree__item--file {
  font-weight: 400;
  color: var(--theme-text-secondary);
}
.file-tree__toggle {
  width: 16px;
  height: 16px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: 10px;
  color: var(--theme-text-dim);
  cursor: pointer;
  flex-shrink: 0;
  transition: transform 200ms ease;
  user-select: none;
}
.file-tree__toggle--expanded {
  transform: rotate(90deg);
}
.file-tree__children {
  padding-left: var(--space-lg);
  overflow: hidden;
  transition: max-height 200ms ease;
}
.file-tree__children--collapsed {
  max-height: 0 !important;
}
.file-tree__icon {
  flex-shrink: 0;
  font-size: 12px;
}

/* Filters */
.filter-group {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-xs);
}
.filter-chip {
  display: inline-flex;
  align-items: center;
  gap: var(--space-xs);
  font-size: 11px;
  padding: 2px var(--space-sm);
  border-radius: var(--radius-full);
  border: 1px solid var(--theme-border);
  background: var(--theme-surface-elevated);
  color: var(--theme-text-secondary);
  cursor: pointer;
  transition: all 150ms ease;
  font-family: var(--font-family);
}
.filter-chip:hover {
  border-color: var(--theme-primary);
  color: var(--theme-text-primary);
}
.filter-chip--active {
  border-color: var(--theme-primary);
  background: var(--theme-primary);
  color: #fff;
}
.filter-chip__dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  display: inline-block;
  flex-shrink: 0;
}

/* Legend */
.legend {
  display: flex;
  flex-direction: column;
  gap: var(--space-xs);
  font-size: 11px;
  color: var(--theme-text-secondary);
}
.legend__row {
  display: flex;
  align-items: center;
  gap: var(--space-sm);
}
.legend__swatch {
  width: 12px;
  height: 12px;
  border-radius: 50%;
  flex-shrink: 0;
  border: 1px solid var(--theme-border);
}
.legend__swatch--edge {
  width: 16px;
  height: 2px;
  border-radius: 0;
  border: none;
}
.legend__label {
  font-size: 11px;
}

.graph-viewer { flex: 1; position: relative; background: var(--theme-bg); overflow: hidden; min-width: 0; }
#cy { width: 100%; height: 100%; background: var(--theme-bg); }
.graph-controls { position: absolute; bottom: var(--space-lg); right: var(--space-lg); display: flex; flex-direction: column; gap: var(--space-xs); background: var(--theme-surface-elevated); border: 1px solid var(--theme-border); border-radius: var(--radius-lg); padding: var(--space-sm); box-shadow: var(--shadow-md); z-index: 5; }
.graph-controls__button { width: 28px; height: 28px; border: none; background: transparent; color: var(--theme-text-secondary); border-radius: var(--radius-sm); cursor: pointer; font-size: 14px; transition: all 150ms ease; }
.graph-controls__button:hover { color: var(--theme-text-primary); background: var(--theme-border); }
.graph-controls__divider { height: 1px; background: var(--theme-border); margin: var(--space-xs) 0; }

.details-panel { width: 280px; min-width: 280px; background: var(--theme-surface); border-left: 1px solid var(--theme-border); display: flex; flex-direction: column; overflow: hidden; flex-shrink: 0; }
.details-panel__header { padding: var(--space-lg); border-bottom: 1px solid var(--theme-border); flex-shrink: 0; }
.details-panel__header-title { font-size: 11px; text-transform: uppercase; letter-spacing: 0.05em; color: var(--theme-text-dim); font-weight: 600; margin-bottom: var(--space-xs); }
.details-panel__node-name { font-size: 18px; font-weight: 600; color: var(--theme-text-primary); word-break: break-all; }
.details-panel__node-type { font-size: 12px; color: var(--theme-text-secondary); margin-top: var(--space-xs); }
.details-panel__node-file { font-size: 12px; color: var(--theme-text-secondary); font-family: var(--font-mono); margin-top: var(--space-xs); word-break: break-all; }
.details-panel__node-id { font-size: 11px; color: var(--theme-text-dim); font-family: var(--font-mono); margin-top: var(--space-xs); }
.details-panel__body { flex: 1; overflow-y: auto; padding: var(--space-lg); }
.details-panel__section { margin-bottom: var(--space-lg); }
.details-panel__section-title { font-size: 11px; text-transform: uppercase; letter-spacing: 0.05em; color: var(--theme-text-dim); font-weight: 600; margin-bottom: var(--space-sm); }
.details-panel__impact-item { display: flex; align-items: center; gap: var(--space-sm); padding: var(--space-xs) 0; font-size: 12px; color: var(--theme-text-secondary); border-bottom: 1px solid var(--theme-border); }
.details-panel__impact-item:last-child { border-bottom: none; }
.details-panel__impact-item .mono { font-size: 12px; color: var(--theme-text-primary); }
.details-panel__actions { display: flex; gap: var(--space-sm); flex-wrap: wrap; margin-top: var(--space-md); }
.details-panel__action { padding: 4px var(--space-md); border: 1px solid var(--theme-border); border-radius: var(--radius-md); background: var(--theme-surface-elevated); color: var(--theme-text-secondary); font-size: 11px; font-family: var(--font-family); cursor: pointer; transition: all 150ms ease; }
.details-panel__action:hover { border-color: var(--theme-primary); color: var(--theme-text-primary); }
.details-panel__action:focus-visible { outline: 2px solid var(--theme-primary); outline-offset: 2px; }
.details-panel__empty { display: flex; flex-direction: column; align-items: center; justify-content: center; height: 100%; color: var(--theme-text-dim); text-align: center; padding: var(--space-xl); }
.details-panel__empty-icon { font-size: 32px; margin-bottom: var(--space-md); opacity: 0.5; }
.details-panel__empty-text { font-size: 13px; color: var(--theme-text-secondary); }

.status-bar { height: 24px; min-height: 24px; display: flex; align-items: center; padding: 0 var(--space-lg); gap: var(--space-xl); background: var(--theme-surface); border-top: 1px solid var(--theme-border); color: var(--theme-text-secondary); font-size: 11px; flex-shrink: 0; }
.status-bar__item { display: flex; align-items: center; gap: var(--space-sm); }
.status-bar__item--right { margin-left: auto; }
.status-bar__theme-indicator { display: flex; align-items: center; gap: var(--space-xs); }

/* ============================================================
   MODAL STYLES
   ============================================================ */
.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.5);
  backdrop-filter: blur(4px);
  display: none;
  justify-content: center;
  align-items: center;
  z-index: 1000;
}
.modal-overlay.open {
  display: flex;
}
.modal {
  background: var(--theme-surface-elevated);
  border: 1px solid var(--theme-border);
  border-radius: var(--radius-xl);
  padding: var(--space-xl);
  max-width: 500px;
  width: 90%;
  max-height: 80vh;
  overflow-y: auto;
  box-shadow: var(--shadow-lg);
  color: var(--theme-text-primary);
  position: relative;
}
.modal__title {
  font-size: 18px;
  font-weight: 600;
  margin-bottom: var(--space-lg);
  display: flex;
  align-items: center;
  gap: var(--space-sm);
}
.modal__close {
  position: absolute;
  top: var(--space-md);
  right: var(--space-md);
  background: transparent;
  border: none;
  color: var(--theme-text-secondary);
  font-size: 20px;
  cursor: pointer;
  padding: var(--space-xs);
  border-radius: var(--radius-sm);
  transition: background 150ms ease;
}
.modal__close:hover {
  background: var(--theme-border);
  color: var(--theme-text-primary);
}
.modal__body {
  display: flex;
  flex-direction: column;
  gap: var(--space-md);
}
.modal__field {
  display: flex;
  flex-direction: column;
  gap: var(--space-xs);
}
.modal__field label {
  font-size: 12px;
  font-weight: 600;
  color: var(--theme-text-secondary);
  text-transform: uppercase;
  letter-spacing: 0.04em;
}
.modal__field input,
.modal__field select {
  padding: var(--space-sm) var(--space-md);
  border: 1px solid var(--theme-border);
  border-radius: var(--radius-md);
  background: var(--theme-surface);
  color: var(--theme-text-primary);
  font-family: var(--font-family);
  font-size: 13px;
  transition: border-color 200ms ease, box-shadow 200ms ease;
}
.modal__field input:focus,
.modal__field select:focus {
  outline: none;
  border-color: var(--theme-primary);
  box-shadow: 0 0 0 3px rgba(88, 166, 255, 0.3);
}
[data-theme="light"] .modal__field input:focus,
[data-theme="light"] .modal__field select:focus {
  box-shadow: 0 0 0 3px rgba(9, 105, 218, 0.3);
}
.modal__field input[type="password"] {
  font-family: var(--font-mono);
}
.modal__actions {
  display: flex;
  gap: var(--space-md);
  margin-top: var(--space-md);
  justify-content: flex-end;
}
.modal__button {
  padding: var(--space-sm) var(--space-lg);
  border: 1px solid var(--theme-border);
  border-radius: var(--radius-md);
  background: var(--theme-surface);
  color: var(--theme-text-primary);
  cursor: pointer;
  font-family: var(--font-family);
  font-size: 13px;
  transition: all 150ms ease;
}
.modal__button:hover {
  background: var(--theme-surface-elevated);
  border-color: var(--theme-primary);
}
.modal__button--primary {
  background: var(--theme-primary);
  color: #fff;
  border-color: var(--theme-primary);
}
.modal__button--primary:hover {
  background: var(--theme-primary-hover);
  border-color: var(--theme-primary-hover);
}
.modal__button:focus-visible {
  outline: 2px solid var(--theme-primary);
  outline-offset: 2px;
}
.modal__status {
  font-size: 12px;
  color: var(--theme-text-secondary);
  margin-top: var(--space-xs);
}

/* ============================================================
   REQUIREMENTS WORKSPACE MODAL STYLES
   ============================================================ */
.workspace-modal {
  background: var(--theme-surface-elevated);
  border: 1px solid var(--theme-border);
  border-radius: var(--radius-xl);
  max-width: 92vw;
  width: 1300px;
  max-height: 90vh;
  display: flex;
  flex-direction: column;
  box-shadow: var(--shadow-lg);
  overflow: hidden;
  color: var(--theme-text-primary);
}

.workspace-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: var(--space-lg) var(--space-xl);
  border-bottom: 1px solid var(--theme-border);
  flex-shrink: 0;
  background: var(--theme-surface);
}
.workspace-header__title {
  font-size: 18px;
  font-weight: 600;
  display: flex;
  align-items: center;
  gap: var(--space-md);
}
.workspace-header__actions {
  display: flex;
  gap: var(--space-sm);
}

.workspace-body {
  flex: 1;
  display: flex;
  flex-direction: column;
  padding: var(--space-lg);
  gap: var(--space-lg);
  overflow: hidden;
  min-height: 0;
}

.workspace-top {
  display: flex;
  gap: var(--space-lg);
  flex: 1;
  min-height: 0;
}

.workspace-panel {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: var(--space-sm);
  min-width: 0;
}
.workspace-panel--right {
  flex: 2;
}

.workspace-panel__label {
  font-size: 11px;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  color: var(--theme-text-dim);
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.workspace-panel__content {
  flex: 1;
  background: var(--theme-surface);
  border: 1px solid var(--theme-border);
  border-radius: var(--radius-md);
  padding: var(--space-md);
  overflow-y: auto;
  min-height: 80px;
}

.workspace-panel__content--code {
  font-family: var(--font-mono);
  font-size: 13px;
  white-space: pre-wrap;
  word-break: break-word;
  color: var(--theme-text-primary);
}

.workspace-panel__textarea {
  flex: 1;
  background: var(--theme-surface);
  border: 1px solid var(--theme-border);
  border-radius: var(--radius-md);
  padding: var(--space-md);
  color: var(--theme-text-primary);
  font-family: var(--font-family);
  font-size: 13px;
  resize: none;
  outline: none;
  min-height: 60px;
  transition: border-color 200ms ease, box-shadow 200ms ease;
}
.workspace-panel__textarea:focus {
  border-color: var(--theme-primary);
  box-shadow: 0 0 0 3px rgba(88, 166, 255, 0.3);
}

.workspace-bottom {
  border-top: 1px solid var(--theme-border);
  padding-top: var(--space-lg);
  flex-shrink: 0;
  max-height: 200px;
  display: flex;
  flex-direction: column;
}

.traceability-table {
  width: 100%;
  border-collapse: collapse;
  font-size: 12px;
}
.traceability-table th {
  text-align: left;
  padding: var(--space-sm) var(--space-md);
  background: var(--theme-surface);
  border-bottom: 2px solid var(--theme-border);
  color: var(--theme-text-secondary);
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.04em;
  position: sticky;
  top: 0;
  z-index: 2;
}
.traceability-table td {
  padding: var(--space-sm) var(--space-md);
  border-bottom: 1px solid var(--theme-border);
  vertical-align: top;
}
.traceability-table .node-ref {
  cursor: pointer;
  color: var(--theme-primary);
  font-family: var(--font-mono);
  font-size: 12px;
  transition: color 150ms ease;
}
.traceability-table .node-ref:hover {
  text-decoration: underline;
  color: var(--theme-primary-hover);
}

.workspace-actions {
  display: flex;
  gap: var(--space-sm);
  flex-wrap: wrap;
}
.workspace-status {
  font-size: 12px;
  color: var(--theme-text-secondary);
  margin-top: var(--space-xs);
}
